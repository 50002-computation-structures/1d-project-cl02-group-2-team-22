// A ripple-carry-adder combinational logic unit
module rca #(
    SIZE = 32 : SIZE > 1
)(
    input a[SIZE],
    input b[SIZE],
    input cin,
    output cout,
    output s[SIZE]
) {
    fa fa[32]  // instantiating 32 instances of fa
    always {
        fa.a = a
        fa.b = b
        fa.cin = 0  // setting default valule to avoid drive error
        // implement ripple-carry-adder logic here 
        repeat(i, 32, 0, 1){    //(variable, count, start, step)
            if (i == 0){
                fa.cin[0] = cin
            }else{
                fa.cin[i] = fa.cout[i-1]
            }
            s[i] = fa.s[i]
        }
        s = fa.s   // connect output bits
        cout = fa.cout[SIZE - 1]
        
    }
}
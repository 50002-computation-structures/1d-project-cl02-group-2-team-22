module static_mode#(
    COLUMN_DIMENSION = 16d30 : COLUMN_DIMENSION > 0,
    ROW_DIMENSION = 16d1 : ROW_DIMENSION > 0,
    PIXEL_COUNT = 16d30 : PIXEL_COUNT > 0,
    BUFFER_SIZE = 1024 : BUFFER_SIZE > 0 // ensure this value is larger than PIXEL_COUNT * $clog2(COLOR_ENCODING)
) (
    input clk,              // 100MHz clock
    input rst,            // reset button (active low)
    output led[8],          // 8 user controllable LEDs
    output io_led[3][8],    // LEDs on IO Shield
    output io_segment[8],   // 7-segment LEDs on IO Shield
    output io_select[4],    // Digit select on IO Shield
    input io_button[5],     // 5 buttons on IO Shield
    //input io_dip[3][8],      // DIP switches on IO Shield
    input colour_choice[2],  // input from alchitry top(testing) or from game_cu (actual)
    output data,
    output debug_colour_choice[2],
    output debug_colour_choice_mux[3]
) {
    
    // GREEN (00), BLUE (10), RED (01), OFF (00)
    const COLOR_ENCODING = {24h0000FF, 24hFF0000, 24h00FF00, 24h0}    
    
    
    sig debug_colour_choice_intermediate[2]
    sig debug_colour_choice_intermediate_mux[3]
    
    sig pixel_address[BUFFER_SIZE]
    
    const CLK_FREQ = $is_sim() ? 1000 : 100000000 
    
    .clk(clk){
        button_conditioner clear_button(#CLK_FREQ(CLK_FREQ), .in(io_button[1]))
        edge_detector clear_button_edge(#RISE(1), #FALL(0), .in(clear_button.out))
        
        .rst(rst){
            dff on_off_toggle(#INIT(1))
        }
        
    }
    const DISPLAY_NOTHING = $reverse({
            2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00,
            2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00, 2b00
            
        })
    
    const DISPLAY_RED = $reverse({
            2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01,
            2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01, 2b01
            
        })
    const DISPLAY_BLUE = $reverse({
            2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10,
            2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10, 2b10
        })
    const DISPLAY_GREEN = $reverse({
            2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11,
            2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11, 2b11
        })
    
    
    ws2812b_driver driver(#PIXEL_COUNT(PIXEL_COUNT), .rst(rst), .clk(clk))
    
    always {
        
        led = 8h00            
        io_led = 3x{{8h00}}
        io_segment = 8hff
        io_select = 4hf
        data = 0
        
        on_off_toggle.d = on_off_toggle.q
        
        driver.update = on_off_toggle.q 
        driver.clear = 0
        
        
        if (clear_button_edge.out){
            driver.clear = 1             
            on_off_toggle.d = ~on_off_toggle.q // toggle the on-off to dictate update
        }
        
        pixel_address = driver.pixel_address
        
        // based on the encoding extracted from dff led_encoding, we get the 24bit color value
        case(colour_choice){
            2b00:
                
                driver.color = COLOR_ENCODING[DISPLAY_RED[$resize(pixel_address, $clog2($width(DISPLAY_RED, 0)))]]
                debug_colour_choice_intermediate_mux = 1
            2b01:
                driver.color = COLOR_ENCODING[DISPLAY_GREEN[$resize(pixel_address, $clog2($width(DISPLAY_GREEN, 0)))]]
                debug_colour_choice_intermediate_mux = 0
            2b10:
                driver.color = COLOR_ENCODING[DISPLAY_BLUE[$resize(pixel_address, $clog2($width(DISPLAY_BLUE, 0)))]]
                debug_colour_choice_intermediate_mux = 2
            
            default:
                driver.color = COLOR_ENCODING[DISPLAY_NOTHING[$resize(pixel_address, $clog2($width(DISPLAY_GREEN, 0)))]]
                debug_colour_choice_intermediate_mux = 3
        }
        data = driver.data
        
        //if(io_dip[2][6]){
            // or show the addresses 
           // io_led[1] = DISPLAY[$resize(pixel_address, $clog2($width(DISPLAY, 0)))]
           // io_led[2] = pixel_address 
       // }
        
        debug_colour_choice_intermediate = colour_choice
        debug_colour_choice = debug_colour_choice_intermediate
        debug_colour_choice_mux = debug_colour_choice_intermediate_mux        
        //driver
        //io_led[0][7:6] = colour_choice
        
        
        led[7] = on_off_toggle.q
        
        
    }
}
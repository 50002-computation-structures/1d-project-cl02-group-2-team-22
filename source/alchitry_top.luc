module alchitry_top (
    input clk,              // 100MHz clock
    input rst_n,            // reset button (active low)
    input game_reset,      // another reset button
    
    output led[8],          // 8 user controllable LEDs
    input usb_rx,           // USB->Serial input
    output usb_tx,           // USB->Serial output
    
    input player_1_red_or_start_button,   // player 1 red button input
    input player_1_green_button,          // player 1 green button input
    input player_1_blue_button,           // player 1 blue button input  
    
    input player_2_red_button,    // player 2 red button input
    input player_2_green_button,  // player 2 green button input
    input player_2_blue_button,   // player 2 blue button input
    
    output player_1_life_1,   // for displaying player 1's lives
    output player_1_life_2,
    output player_1_life_3,
    output player_1_life_4,
    output player_1_life_5,
    
    output player_2_life_1,   // for displaying player 2's lives
    output player_2_life_2,
    output player_2_life_3,
    output player_2_life_4,
    output player_2_life_5,    
    
    output arcade_buttons_light,
    
    output io_led[3][8],     // LEDs on IO Shield
    output io_segment[8],        // 7-segment LEDs on IO Shield
    output io_select[4],        // Digit select on IO Shield
    input io_button[5],      // 5 buttons on IO Shield
    input io_dip[3][8],       // DIP switches on IO Shield
    
    output data
    
) {

    sig rst                 // reset signal
    
    

    .clk(clk) {
        // The reset conditioner is used to synchronize the reset signal to the FPGA
        // clock. This ensures the entire FPGA comes out of reset at the same time.
        reset_conditioner reset_cond
        
        
        
        .rst(rst){
            
            datapath game_datapath ( 
                .player_1_red_or_start_button(player_1_red_or_start_button), 
                .player_1_green_button(player_1_green_button),
                .player_1_blue_button(player_1_blue_button),
            
                .player_2_red_button(player_2_red_button),
                .player_2_green_button(player_2_green_button),
                .player_2_blue_button(player_2_blue_button),
                .io_button(io_button))            
        }
    }

   

    

    always {
        // driving player lives outputs
        player_1_life_1 = 0
        player_1_life_2 = 0
        player_1_life_3 = 0
        player_1_life_4 = 0
        player_1_life_5 = 0
        
        player_2_life_1 = 0
        player_2_life_2 = 0
        player_2_life_3 = 0
        player_2_life_4 = 0
        player_2_life_5 = 0 
        
        
        
        
        
        data = 0  // data to disaply on ws2812b strip
        io_segment = 0  // individual 7 seg LED will light up based on bit 1 or 0
        io_select = 4h0 // F means the selected 7 seg is off
        io_led = 3x{{8b0}}
        led = 8h00              // LED set to off
        
        
            // for testing if button works. If button works, it will light up
            io_led[0][0] = player_1_red_or_start_button
            io_led[0][1] = player_1_green_button
            io_led[0][2] = player_1_blue_button
            
            io_led[1][0] = player_2_red_button
            io_led[1][1] = player_2_green_button
            io_led[1][2] = player_2_blue_button
        
        
            // dispaly what is in register 2, which stores current_colour
            //io_led[1][4:3] = game_datapath.debuggerino
            //io_led[1][7:5] = game_datapath.player_button_input
        
        
            //io_led[1][3] = game_datapath.is_player_1_correct
            //io_led[1][7:5] = game_datapath.current_p2_lives
            
            io_led[1][3] = game_datapath.is_player_2_correct
            io_led[1][7:5] = game_datapath.current_p1_lives
        
            
              
            data = game_datapath.ws2812b_data  // for ws2812b display
            io_led[2] = game_datapath.current_state  // get current state from datapath to display
        
        // display player 1 lives
        case(game_datapath.current_p1_lives){
            d5:
                player_1_life_1 = 1
                player_1_life_2 = 1
                player_1_life_3 = 1
                player_1_life_4 = 1
                player_1_life_5 = 1
            d4:
                player_1_life_1 = 1
                player_1_life_2 = 1
                player_1_life_3 = 1
                player_1_life_4 = 1
                player_1_life_5 = 0
            d3:
                player_1_life_1 = 1
                player_1_life_2 = 1
                player_1_life_3 = 1
                player_1_life_4 = 0
                player_1_life_5 = 0
            d2:
                player_1_life_1 = 1
                player_1_life_2 = 1
                player_1_life_3 = 0
                player_1_life_4 = 0
                player_1_life_5 = 0
            d1:
                player_1_life_1 = 1
                player_1_life_2 = 0
                player_1_life_3 = 0
                player_1_life_4 = 0
                player_1_life_5 = 0
            d0:
                player_1_life_1 = 0
                player_1_life_2 = 0
                player_1_life_3 = 0
                player_1_life_4 = 0
                player_1_life_5 = 0
        }
        
        // display player 2 lives
        case(game_datapath.current_p2_lives){
            d5:
                player_2_life_1 = 1
                player_2_life_2 = 1
                player_2_life_3 = 1
                player_2_life_4 = 1
                player_2_life_5 = 1  
            d4:
                player_2_life_1 = 1
                player_2_life_2 = 1
                player_2_life_3 = 1
                player_2_life_4 = 1
                player_2_life_5 = 0
            d3:
                player_2_life_1 = 1
                player_2_life_2 = 1
                player_2_life_3 = 1
                player_2_life_4 = 0
                player_2_life_5 = 0  
            d2:
                player_2_life_1 = 1
                player_2_life_2 = 1
                player_2_life_3 = 0
                player_2_life_4 = 0
                player_2_life_5 = 0  
            d1:
                player_2_life_1 = 1
                player_2_life_2 = 0
                player_2_life_3 = 0
                player_2_life_4 = 0
                player_2_life_5 = 0  
            d0:
                player_2_life_1 = 0
                player_2_life_2 = 0
                player_2_life_3 = 0
                player_2_life_4 = 0
                player_2_life_5 = 0  
        }
        
        case(game_datapath.arcade_buttons_light_up){
            d1:
              arcade_buttons_light = 1   
             
            default:
              arcade_buttons_light = 0
        }
        
        


        reset_cond.in = ~rst_n | ~game_reset // input raw inverted reset signal
        rst = reset_cond.out    // conditioned reset

        
       

        usb_tx = usb_rx         // echo the serial data
        
    }
}
module right_shifter (
    input a[32], // input we are shifting by
    input b[5],  // how many bits we are shifting by
    //input alufn[6],  //determine SHL(00), SHR(01) or SRA(11)
    // SHL, SHR fills in with 0, SHR fills in with MSB (bit 31)
    output shift[32]
) {
    mux_2 shr_16[32]
    mux_2 shr_8[32] 
    mux_2 shr_4[32]
    mux_2 shr_2[32]
    mux_2 shr_1[32]
    
    sig wr[32]
    sig xr[32]
    sig yr[32]
    sig zr[32]
    
    
    always {
        //setting selector inputs
        repeat(i, 32, 0, 1){
            shr_16.s0[i] = b[4]
            shr_8.s0[i] = b[3]
            shr_4.s0[i] = b[2]
            shr_2.s0[i] = b[1]
            shr_1.s0[i] = b[0]   
        }
        
        shr_16.in = 32x{{2b00}}  // 2b as you have 2 different pathways to encode
        shr_8.in = 32x{{2b00}}
        shr_4.in = 32x{{2b00}}
        shr_2.in = 32x{{2b00}}
        shr_1.in = 32x{{2b00}}
        
        wr = 32x{1b0}
        xr = 32x{1b0}
        yr = 32x{1b0}
        zr = 32x{1b0}
        
            repeat(i, 32, 0, 1){
                shr_16.in[i][0] = a[i]  // input at path 0 is just a
                // input at path 1 is below
                
                if (i >= 16){   // replace leftmost 16b with 0s
                    shr_16.in[i][1] = 1b0
                }else{   // replace rightmost 16b with bits 16b to their left
                    shr_16.in[i][1] = a[i+16]  
                }            
            }
            wr = shr_16.out
            
            repeat(i, 32, 0, 1){
                shr_8.in[i][0] = wr[i]  // input at path 0 is just wr
                // input at path 1 is below
                
                if (i >= 24){   // replace leftmost 8b with 0s
                    shr_8.in[i][1] = 1b0
                }else{   // replace rightmost 24b with bits 8b to their left
                    shr_8.in[i][1] = wr[i+8]  
                }            
            }
            xr = shr_8.out
            
            repeat(i, 32, 0, 1){
                shr_4.in[i][0] = xr[i]  // input at path 0 is just xr
                // input at path 1 is below
                
                if (i >= 28){   // replace leftmost 4b with 0s
                    shr_4.in[i][1] = 1b0
                }else{   // replace rightmost 28b with bits 4b to their left
                    shr_4.in[i][1] = xr[i+4]  
                }            
            }
            yr = shr_4.out
            
            repeat(i, 32, 0, 1){
                shr_2.in[i][0] = yr[i]  // input at path 0 is just yr
                // input at path 1 is below
                
                if (i >= 30){   // replace leftmost 2b with 0s
                    shr_2.in[i][1] = 1b0
                }else{   // replace rightmost 30b with bits 2b to their left
                    shr_2.in[i][1] = yr[i+2]  
                }            
            }
            zr = shr_2.out
            
            repeat(i, 32, 0, 1){
                shr_1.in[i][0] = zr[i]  // input at path 0 is just zr
                // input at path 1 is below
                
                if (i == 31){   // replace leftmost 1b with 0
                    shr_1.in[i][1] = 1b0
                }else{   // replace rightmost 31b with bits 1b to their left
                    shr_1.in[i][1] = zr[i+1]  
                }            
            }          
            shift = shr_1.out 
    }
}
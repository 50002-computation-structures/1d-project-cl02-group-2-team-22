module alu_manual_tester (
    input clk,              // 100MHz clock
    input rst,            // reset button (active low)
    output led[8],          // 8 user controllable LEDs on the rightside (vertical)
    //input usb_rx,            // USB->Serial input
    //output usb_tx,           // USB->Serial output
    output io_led[3][8],     // LEDs on IO Shield
    output io_segment[8],        // 7-segment LEDs on IO Shield
    output io_select[4],        // Digit select on IO Shield
    input io_button[5],      // 5 buttons on IO Shield
    input io_dip[3][8]       // DIP switches on IO Shield
) {
    
                   // reset signal
    
    enum States {
        A_LS16B,  // state where we input the least significant 16bits of a
        A_MS16B,   // state where we input the most significant 16bits of a 
        B_LS16B,   // state where we input the least significant 16bits of b
        B_MS16B,   // state where we input the most significant 16bits of b
        ALUFN,    // state where we input the 6 bit alufn code 
        ANSWER_LS16B,  // state where we display the least significant 16bits of the output
        ANSWER_MS16B   // state where we display the most significant 16bits of the output
    }
    
    const CLK_FREQ = $is_sim() ? 1000 : 10000000 // put 1000 only for sim, 10M on hardware
    const SEVEN_SEG_DIV = $is_sim() ? 3 : 16   // for seven seg display

    alu alu
    
    
    .clk(clk) {
        // The clock conditioner is used to synchronize the clk signal to the FPGA
        // clock. This ensures the entire FPGA comes out of clk at the same time.
        
        
        // initialise array of 5 button_edge_detectors to detect edge for each of the 5 buttons later
        // when clock edge rises, output 1, when it falls output 0
        edge_detector io_button_edge[5](#RISE(5x{{1}}), #FALL(5x{{0}}))  
        // initialise array of 5 button_conditioners to debounce each button later
        
        button_conditioner io_button_cond[5](#CLK_FREQ(5x{{CLK_FREQ}})) 
        
         // The reset conditioner is used to synchronize the reset signal to the FPGA
        // clock. This ensures the entire FPGA comes out of reset at the same time.
        .rst(rst) {
            multi_seven_seg seg(#DIV(SEVEN_SEG_DIV))  // instantiating seven seg
            
            dff states[$width(States)](#INIT(States.A_LS16B))  // dff to hold states
            dff a[32](#INIT(0))   // dff to hold value of input a (32bits)
            dff b[32](#INIT(0))  // dff to hold value of input b (32bits)
            dff alufn[6](#INIT(0))   // dff to hold value of alufn (6bits)
        }
        
    }
    bin_to_dec decimal_renderer(#DIGITS(4), #LEADING_ZEROS(1))  // for seven seg
    
    always {
        //setting defaults values to drive the inputs
        alu.a = 0
        alu.b = 0
        alu.alufn = 0
        io_led = 3x{{8h0}}
        io_segment = 0
        io_select = 4hF
        led = 0
        
        // condition the buttons so that they take rising edges only
        io_button_cond.in = io_button
        io_button_edge.in = io_button_cond.out

       
        
        // connect dffs 
        states.d = states.q
        a.d=a.q
        b.d=b.q
        alufn.d=alufn.q

        case (states.q){
            
            // start of states where we are keying in inputs
            States.A_LS16B:
                led[1]=1  // to indicate which state we are currently in
                io_led=io_dip
                if (io_button_edge.out[4]){   // on button click, 
                    a.d[15:0] = c{io_dip[1],io_dip[0]}  //set the least sig 16bits of dff a to what you input in io_dip
                    states.d = States.A_MS16B    // change state to input the most sig 16bits of a
                }

            States.A_MS16B :
                led[2]=1  // to indicate which state we are currently in
                io_led=io_dip 
                if (io_button_edge.out[4]){  // on clicking button 4,
                    a.d[31:16] = c{io_dip[1],io_dip[0]} //set the most sig 16bits of dff a to what you input in io_dip
                    states.d = States.B_LS16B   // change state to input the least sig 16bits of b
                }
                else if (io_button_edge.out[3]){  // on clicking button 3
                    states.d = States.A_LS16B   // go back to previous state to alter least sig 16bit of dff a
                }
            
            States.B_LS16B:
                led[3]=1  // to indicate which state we are currently in
                io_led=io_dip 
                if (io_button_edge.out[4]){  // on clicking button 4,
                    b.d[15:0] = c{io_dip[1],io_dip[0]}  //set the least sig 16bits of dff b to what you input in io_dip
                    states.d = States.B_MS16B  // change state to input the most sig 16bits of b
                }
                else if (io_button_edge.out[3]){ // on clicking button 3,
                    states.d = States.A_MS16B // go back to previous state to alter most sig 16bit of dff a
                }
            
            States.B_MS16B:
                led[4]=1  // to indicate which state we are currently in
                io_led=io_dip 
                if (io_button_edge.out[4]){  // on clicking button 4,
                    b.d[31:16] = c{io_dip[1],io_dip[0]}  //set the most sig 16bits of dff b to what you input in io_dip
                    states.d = States.ALUFN   // change state to input the ALUFN code
                }
                else if (io_button_edge.out[3]){  // on clicking button 3,
                    states.d = States.B_LS16B  // go back to previous state to alter least sig 16bit of dff b
                }
            // end of states where we are keying in inputs

            
            // start of ALUFN state
            States.ALUFN:
                led[5] = 1 // to indicate which state we are currently in
                io_led=io_dip
                if (io_button_edge.out[4]){ // on clicking button 4,
                    alufn.d = io_dip[2][5:0]   // set dff alufn to what you input in io_dip
                    states.d = States.ANSWER_LS16B  // change state to show least sig 16b of answer
                }
                else if (io_button_edge.out[3]){  // on clicking button 3,
                    states.d = States.B_MS16B  // go back to previous state to alter most sig 16bit of dff b
                }
                // end of ALUFN state
            
            
            
            // start of states that show output
            States.ANSWER_LS16B:
                led[6] = 1
                alu.a=a.q       // setting "a" input of alu to be what was saved in dff a 
                alu.b=b.q       // setting "b" input of alu to be what was saved in dff b
                alu.alufn = alufn.q   // setting alufn input of alu to be what was saved in dff alufn
                
                io_led[0]=alu.out[7:0]            // these two lines are displaying the output of-
                io_led[1]=alu.out[15:8]           // the least sig 16b of output
                io_led[2][2:0]=c{alu.z,alu.v,alu.n}    // set least sig 3bits of io_led[2] to display z,v and n
                if (io_button_edge.out[4]){
                    states.d = States.ANSWER_MS16B   
                }
                else if (io_button_edge.out[3]){
                    states.d = States.ALUFN
                }
                
               States.ANSWER_MS16B:
                led[7] = 1 
                alu.a=a.q       // setting "a" input of alu to be what was saved in dff a 
                alu.b=b.q       // setting "b" input of alu to be what was saved in dff b
                alu.alufn = alufn.q   // setting alufn input of alu to be what was saved in dff alufn
                
                io_led[0]=alu.out[23:16]   // these two lines are displaying the output of-
                io_led[1]=alu.out[31:24]   // the most sig 16b of output
                io_led[2][2:0]=c{alu.z,alu.v,alu.n}  // set least sig 3bits of io_led[2] to display z,v and n
                if (io_button_edge.out[4]){
                    states.d = States.A_LS16B
                }
                else if (io_button_edge.out[3]){
                    states.d = States.ANSWER_LS16B
                }
            // end of states that show output
        }
        
        // convert the binary output to decimal value for z, v, n
        if(c{alu.z,alu.v,alu.n} == 3b000)
            decimal_renderer.value = 4h0
        else if(c{alu.z,alu.v,alu.n} == 3b001)
            decimal_renderer.value = 4h1
        else if(c{alu.z,alu.v,alu.n} == 3b010)
            decimal_renderer.value = 4hA
        else if(c{alu.z,alu.v,alu.n} == 3b011)
            decimal_renderer.value = 4hB
        else if(c{alu.z,alu.v,alu.n} == 3b100)
            decimal_renderer.value = 100
        else if(c{alu.z,alu.v,alu.n} == 3b101)
            decimal_renderer.value = 101
        else if(c{alu.z,alu.v,alu.n} == 3b110)
            decimal_renderer.value = 110
        else if(c{alu.z,alu.v,alu.n} == 3b111)
            decimal_renderer.value = 111
        else
            decimal_renderer.value = 0
        
        seg.values = decimal_renderer.digits // plug the decimal digits into 7seg controller
        io_segment = ~seg.seg
        io_select = ~seg.sel
    }


        
    
    
}

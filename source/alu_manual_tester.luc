module alu_manual_tester#(
    CLK_FREQ ~ 1000 : CLK_FREQ > 0) 
(
    input clk,  // clock
    input rst,  // reset
    input io_button[5],
    input io_dip[3][8],
    output io_led[3][8],
    output io_segment[8],
    output io_select[4]
) {
    alu alu
    
    always {
        // implement alu tester logic here
        //alu.a[31:24] = io_dip[0]
        //alu.b[31:24] = io_dip[1]
        alu.a[31:8] = 0
        alu.b[31:8] = 0  //8388607
        //alu.b[31:8] = 24b0111111111111111111111111
        alu.a[7:0] = io_dip[0]
        alu.b[7:0] = io_dip[1]
        

        alu.alufn = io_dip[2][5:0]  
        io_led = 3x{{8h0}}
        io_segment = 0
        io_select = 4hF
        io_led[0] = alu.out[7:0]
        io_led[1] = c{alu.z, alu.v, alu.n}
        
    }
}
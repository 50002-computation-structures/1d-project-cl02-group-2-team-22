module adder #(
    SIZE = 32 : SIZE > 1
)(
    input a[SIZE],
    input b[SIZE],
    input alufn_signal[6],
    output s[SIZE],
    output z,
    output v,
    output n
) {
    rca rca
    sig sum[SIZE]
    sig subtract
    sig b_neg[SIZE]
    
    
    always {
        // implement adder/subtractor unit logic here
        subtract = alufn_signal[0]
        b_neg = b ^ 32x{alufn_signal[0]} // if alufn = 0, b input stays the same but if alufn is 1, b input flip for every bit
                                         // 1's complement
        rca.a = a
        rca.b = b_neg
        rca.cin = alufn_signal[0]   // acts as the +1 in 2's complement
        sum = rca.s
        s = sum
        n = sum[SIZE - 1]  // bit number 31 (bits start counting from 0)
        
        
        z = ~| sum // NOR of all bits of the sum (inverted OR)
        
        //v = 0 //default is 0
        v = (a[31] == b_neg[31]) && (rca.s[31] != a[31]);
        

    }
}
